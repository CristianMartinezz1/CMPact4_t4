meta {
  name: 12 Validacion fallida (400)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "matricula": "123",
    "nombre": "",
    "email": "esto-no-es-correo",
    "semestre": 20
  }
}

tests {
  test("400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  test("Indica qué campos fallaron", function() {
    expect(res.body.errores).to.have.property("matricula");
  });
}
